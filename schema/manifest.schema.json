{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vade.local/schema/manifest.schema.json",
  "title": "Vade module manifest",
  "description": "C-03. The only accepted shape of `module/register` and `module/capabilities.update` payloads. Forward compatible: unknown fields are ignored (`additionalProperties: true` everywhere), unknown capability types are ignored with a warning by the registry. The `schema/` file is the single source of truth; core/vade/registry/manifest.py implements the checks that JSON Schema cannot express (protocol major, global tool budget, cross-module conflicts).",
  "x-vade": {
    "contract": "C-03",
    "version": "1.0.0",
    "status": "frozen",
    "frozen_at": "2026-11-13",
    "owner": "C2",
    "consumers": [
      "C4",
      "M1",
      "M2",
      "M3",
      "M4a",
      "M4b",
      "M5",
      "M6",
      "C5a"
    ],
    "limits": {
      "tools_per_module": 64,
      "tools_global": 128,
      "tool_name_max_len": 64,
      "description_max_len": 512,
      "max_payload_ceiling": 65519,
      "timeout_ms_min": 100,
      "timeout_ms_max": 600000,
      "pages_per_module": 8,
      "ui_block_max_bytes": 49152,
      "ui_inline_max_bytes": 8192,
      "ui_ref_max_bytes": 65536,
      "ui_nodes_per_page": 256,
      "ui_depth_max": 8
    },
    "appends": [
      {
        "contract": "C-14",
        "version": "1.0.0",
        "fields": [
          "subscriptions"
        ],
        "doc": "docs/rfc/RFC-0001-manifest-subscriptions.md",
        "why": "C-03 shipped without the field C-14's manifest gate reads. `additionalProperties: true` let a module send it, but `Manifest` dropped it, so every real registration was rejected `not in manifest`."
      },
      {
        "contract": "C-19",
        "version": "1.0.0",
        "fields": [
          "ui"
        ],
        "doc": "docs/rfc/RFC-0009-module-ui-pages.md",
        "why": "C-03 shipped without a page surface, so a module's only UI was the out-of-process `webui`. Same trap as C-14: `additionalProperties: true` lets `ui` through, but a `Manifest` that does not parse it drops it silently. The `ui` subtree is the one place where `additionalProperties` is false -- an unknown key in a page can only be a script hook."
      }
    ]
  },
  "type": "object",
  "required": [
    "module_id",
    "instance_id",
    "version",
    "protocol",
    "capabilities",
    "limits"
  ],
  "additionalProperties": true,
  "properties": {
    "module_id": {
      "type": "string",
      "description": "Reverse-DNS, lowercase. Must not contain '/', '#', control characters.",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "minLength": 3,
      "maxLength": 128
    },
    "instance_id": {
      "type": "string",
      "description": "Unique inside one module. `module_id#instance_id` is the node id in the admin topology.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "version": {
      "type": "string",
      "description": "SemVer 2.0.0.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "protocol": {
      "type": "string",
      "description": "Protocol version. Major version must be 1; the registry rejects `vade/v2` with PROTOCOL_MISMATCH before anything else is trusted. Patch/minor are accepted with a warning.",
      "pattern": "^vade/v[0-9]+(\\.[0-9]+){0,2}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "role": {
      "type": "string",
      "description": "Self-declared role. `evolve` is only honoured when the fingerprint is in core's [evolve].allowlist; otherwise it is demoted to `tool`.",
      "enum": [
        "tool",
        "evolve",
        "ui"
      ],
      "default": "tool"
    },
    "concurrency": {
      "type": "string",
      "description": "exclusive: one instance per module (second registration -> TOOL_CONFLICT). pooled: up to limits.max_concurrency instances, least-inflight routing. mirrored: any number, no load, events broadcast.",
      "enum": [
        "exclusive",
        "pooled",
        "mirrored"
      ],
      "default": "exclusive"
    },
    "priority": {
      "type": "integer",
      "description": "Model module selection order; higher wins.",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "capabilities": {
      "type": "object",
      "required": [
        "tools"
      ],
      "additionalProperties": true,
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "prompts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/prompt"
          }
        },
        "events": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "maxLength": 64
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_concurrency",
        "max_payload"
      ],
      "additionalProperties": true,
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 1
        },
        "max_payload": {
          "type": "integer",
          "description": "Logical payload limit. Physical ceiling is 65519 bytes of plaintext per frame (Noise MAXMSGLEN 65535 minus 16-byte tag, C-01 §7.5); the registry rejects values above it instead of silently promising more than the transport can carry.",
          "minimum": 1024,
          "maximum": 65519,
          "default": 65519
        }
      }
    },
    "injects": {
      "type": "array",
      "description": "Only declared sources are injected. `session_id` is the only source implemented in v1; anything else is rejected.",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "session_id"
        ]
      }
    },
    "subscriptions": {
      "type": "array",
      "description": "C-14 append (RFC-0001). Topics this module wants pushed through `events/deliver`. Registration checks the shape only; topic names are validated at `events/subscribe`, where an unknown or ungranted topic is a per-topic rejection (`rejected: [{topic, reason}]`) rather than a manifest error -- C-03 is frozen and must not start rejecting names C-14 owns.",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "maxLength": 64
      }
    },
    "extensions": {
      "type": "object",
      "description": "Opaque to core. Never parsed, never forwarded to the admin API."
    },
    "ui": {
      "type": "object",
      "description": "C-19 append (RFC-0009 §9.2). Declarative module pages. STRICT on purpose: this is the one subtree in C-03 where `additionalProperties` is false, because an unknown key inside a page is a script hook, not forward compatibility. A page that fails validation is dropped with a warning (`Manifest.ui_warnings`); the module's tools still register. `ui.pages` missing or empty means the module has NO entry anywhere (FR-8.79 §8.2): no empty tab, no placeholder row.",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": [
        "name",
        "description",
        "input_schema",
        "risk",
        "timeout_ms",
        "idempotent"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Matches `^[a-z][a-z0-9_]{0,63}$`; total length <= 64. `module_id/name` is globally unique."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Non-empty: the model cannot decide when to call an undescribed tool."
        },
        "input_schema": {
          "type": "object",
          "description": "Any JSON Schema, but the root `type` must be `object`.",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          },
          "additionalProperties": true
        },
        "risk": {
          "type": "string",
          "description": "Declared risk. core adjudicates against [policy.tool_risk] and may only raise it. Unlisted tools become `high`.",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000,
          "default": 30000
        },
        "output_schema": {
          "type": "object",
          "description": "Optional. Root type must also be `object` when present."
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": [
        "id",
        "content"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "description": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "page": {
      "type": "object",
      "description": "One page declaration. `schema` is either the inline node tree (<=8 KiB serialised) or `{\"ref\": {page_id, sha256}}` (<=64 KiB, fetched through `ui/page.get`; the digest is pinned here so a page cannot be swapped after registration).",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "id",
        "title",
        "version",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "enum": [
            "list",
            "chart",
            "settings",
            "tool",
            "file",
            "none"
          ],
          "default": "none"
        },
        "entry": {
          "enum": [
            "auto",
            "panel",
            "capabilities"
          ],
          "default": "auto"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "requires": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "enum": [
              "session"
            ]
          }
        },
        "refresh_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Optional client hint: how often to re-issue `ui/state.get` while the page is open. Absent = refresh on entry, on `online` and on user retry only. core's own cache ceiling is [ui].state_cache_s."
        },
        "schema": {
          "oneOf": [
            {
              "$ref": "#/$defs/node",
              "description": "Inline node tree root (column/row/tabs/list/text/component). Closed: see $defs/node."
            },
            {
              "type": "object",
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "object",
                  "required": [
                    "page_id",
                    "sha256"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "page_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "uiProps": {
      "type": "object",
      "description": "RFC-0009 §4.4/§4.5: props are a CLOSED set. This union is the coarse gate — a consumer that only runs the JSON Schema still cannot smuggle `onClick`/`script`/an unknown prop through, because `additionalProperties` is false. Per-component precision (Button has no `label`, a leaf has no `children`) lives in `core/vade/registry/uipage.py`, which is the authority.",
      "additionalProperties": false,
      "properties": {
        "gap": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "align": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "wrap": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "selected": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "empty_text": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "item_fields": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "max_lines": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "multiline": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "max_length": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "subtitle": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "elevated": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "leading_icon": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "trailing_text": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "args_preview": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "result_summary": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "file_id": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "mime": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "tab_title": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      }
    },
    "uiAction": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "description": "RFC-0009 §6: one action. The key set is closed so a `then`/`script`/`href` cannot ride along; `kind` is one of the four the host understands.",
      "properties": {
        "kind": {
          "enum": [
            "navigate",
            "tools/call",
            "ui/submit",
            "open_url"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "args": {
          "type": "object"
        },
        "confirm_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "uiOn": {
      "type": "object",
      "additionalProperties": false,
      "description": "RFC-0009 §4.4: only the events a component really emits. `onClick`/`onLoad` are not events, they are script hooks.",
      "properties": {
        "click": {
          "$ref": "#/$defs/uiAction"
        },
        "change": {
          "$ref": "#/$defs/uiAction"
        }
      }
    },
    "uiBinding": {
      "type": "object",
      "required": [
        "bind"
      ],
      "additionalProperties": false,
      "description": "RFC-0009 §5.2: `{\"bind\": path, \"format\"?: name}`. No expressions.",
      "properties": {
        "bind": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "RFC-0009 §4.3/§4.4: one node of the declarative tree. CLOSED at every level (type/component/id/visible/data_ref/props/children/on) so a consumer that only validates against this file still refuses `onClick`, `script`, `href`, a host component or an unknown prop. Node/depth/action counts and per-component prop sets are enforced in `core/vade/registry/uipage.py`.",
      "properties": {
        "type": {
          "enum": [
            "column",
            "row",
            "tabs",
            "list",
            "text",
            "component"
          ]
        },
        "component": {
          "enum": [
            "Button",
            "TextField",
            "Card",
            "ListItem",
            "Switch",
            "ToolCallCard",
            "AttachmentChip"
          ],
          "description": "The seven page components. The four host components (MessageBubble/InputBar/ApprovalDialog/BottomBar) are NOT in this enum: naming one is phishing."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "visible": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/uiBinding"
            }
          ]
        },
        "data_ref": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "$ref": "#/$defs/uiProps"
        },
        "children": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "on": {
          "$ref": "#/$defs/uiOn"
        }
      }
    }
  }
}
