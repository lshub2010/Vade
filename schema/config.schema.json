{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vade.local/schema/config.schema.json",
  "title": "Vade core.toml (C-18)",
  "description": "C-18. The single source of default values, apply semantics (hot|restart) and ownership for every core.toml key. Core loads it at startup; C3/C3b/C5a/M4a/M4b/F1 must read defaults from here instead of hardcoding numbers. Unknown keys are REJECTED at startup with UNKNOWN_CONFIG_KEY, never silently defaulted.",
  "type": "object",
  "additionalProperties": false,
  "x-vade": {
    "contract": "C-18",
    "version": "1.1.0",
    "status": "frozen",
    "frozen_at": "2026-11-13",
    "owner": "C2",
    "consumers": ["C3", "C3b", "C5a", "M4a", "M4b", "F1"],
    "merge_order": ["cli", "env", "overrides", "toml", "defaults"],
    "merge_order_note": "Later entries are overridden by earlier ones: CLI > env > data/config.overrides.json > core.toml > defaults.",
    "env_prefix": "VADE_",
    "env_nesting": "__",
    "env_example": "VADE_CORE__LISTEN=127.0.0.1:9443 overrides [core].listen",
    "overrides_path": "data/config.overrides.json",
    "overrides_note": "Written by the admin page only. Never written back into core.toml: upgrades would clobber it, diffs and audit would lie. C2 only reads and validates it.",
    "secrets_rule": "Secret-bearing keys accept an ENV VAR NAME only (e.g. api_key_env = \"OPENAI_API_KEY\"), never a literal. A literal `sk-...` in core.toml aborts startup.",
    "unknown_key_rule": "Any key not present in this schema -> UNKNOWN_CONFIG_KEY and abort startup (typos must not fall back to defaults).",
    "apply_values": ["hot", "restart"],
    "config_changed": {
      "audit_event": "config.changed",
      "payload": {
        "keys": ["string (dotted path)"],
        "apply": "hot|restart",
        "actor": "string (admin user id or 'cli')",
        "source": "overrides|cli|env",
        "before_digest": "sha256 hex of the previous value set",
        "after_digest": "sha256 hex of the new value set"
      },
      "note": "Never carries secret VALUES, only key names and digests. C5a emits it; C2 defines the shape here."
    }
  },
  "properties": {
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": {"type": "string", "default": "127.0.0.1:8443", "x-vade": {"apply": "restart", "owner": "C2", "pattern": "^[^:]+:[0-9]{1,5}$"}},
        "admin_host": {"type": "string", "default": "127.0.0.1:8444", "x-vade": {"apply": "restart", "owner": "C5a"}},
        "data_dir": {"type": "string", "default": "./data", "x-vade": {"apply": "restart", "owner": "C2"}},
        "log_level": {"type": "string", "enum": ["debug", "info", "warning", "error"], "default": "info", "x-vade": {"apply": "hot", "owner": "C2"}},
        "heartbeat_interval_s": {"type": "number", "minimum": 1, "maximum": 120, "default": 10, "x-vade": {"apply": "restart", "owner": "C2"}},
        "handshake_timeout_s": {"type": "number", "minimum": 1, "maximum": 60, "default": 5, "x-vade": {"apply": "restart", "owner": "C2"}},
        "send_queue_frames": {"type": "integer", "minimum": 8, "maximum": 4096, "default": 256, "x-vade": {"apply": "restart", "owner": "C2"}},
        "rekey_after_s": {"type": "integer", "minimum": 60, "default": 86400, "x-vade": {"apply": "restart", "owner": "C2"}},
        "rekey_after_bytes": {"type": "integer", "minimum": 1048576, "default": 1073741824, "x-vade": {"apply": "restart", "owner": "C2"}},
        "rekey_after_frames": {"type": "integer", "minimum": 1024, "default": 1048576, "x-vade": {"apply": "restart", "owner": "C2"}}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cert": {"type": ["string", "null"], "default": null, "x-vade": {"apply": "restart", "owner": "C2", "note": "null = auto-generated self-signed; loopback only."}},
        "key": {"type": ["string", "null"], "default": null, "x-vade": {"apply": "restart", "owner": "C2"}},
        "spki_pin": {"type": ["string", "null"], "default": null, "x-vade": {"apply": "restart", "owner": "C2", "pattern": "^[0-9a-f]{16,64}$"}},
        "san": {"type": "array", "items": {"type": "string"}, "default": [], "x-vade": {"apply": "restart", "owner": "C2"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_timeout_s": {"type": "integer", "minimum": 5, "maximum": 3600, "default": 60, "x-vade": {"apply": "hot", "owner": "C5a"}},
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 500, "default": 40, "x-vade": {"apply": "hot", "owner": "C3"}},
        "max_tool_result_tokens": {"type": "integer", "minimum": 128, "maximum": 200000, "default": 4000, "x-vade": {"apply": "hot", "owner": "C3"}},
        "tool_risk": {
          "type": "object",
          "description": "Risk adjudication table keyed by module_id then tool name. Anything absent is `high`. Values may only raise the manifest-declared risk; shell / fs.write / fs.delete / *forget* have a hard-coded floor of `high` that this table cannot lower.",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "string", "enum": ["low", "medium", "high"]}
          },
          "x-vade": {"apply": "hot", "owner": "C5a"}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650, "default": 30, "x-vade": {"apply": "restart", "owner": "C5a"}},
        "path": {"type": "string", "default": "data/audit.sqlite3", "x-vade": {"apply": "restart", "owner": "C5a"}}
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui_origins": {
          "type": "array",
          "items": {"type": "string", "pattern": "^https?://[^/]+$"},
          "default": [],
          "x-vade": {"apply": "restart", "owner": "C2", "note": "Exact-match CORS allowlist for /ui/session. `*` is forbidden. Empty = emit no CORS headers. Each origin's host must be in listen_hosts or startup is refused."}
        },
        "listen_hosts": {
          "type": "array",
          "items": {"type": "string"},
          "default": ["127.0.0.1", "localhost"],
          "x-vade": {"apply": "restart", "owner": "C2", "note": "Accepted Host header names on the data plane. One listener, several DNS names — do not start two listeners for these."}
        }
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "description": "RFC-0004 attachment upload channel (`/ui/blob*`). Additive to C-18 1.0.0; the root stays additionalProperties:false, so a typo here is UNKNOWN_CONFIG_KEY at startup rather than a silent default.",
      "properties": {
        "enabled": {"type": "boolean", "default": true, "x-vade": {"apply": "restart", "owner": "C2", "note": "false => /ui/blob* is 404 (the route does not exist) and ui/submit refuses image/file parts."}},
        "max_bytes": {"type": "integer", "minimum": 1024, "default": 104857600, "x-vade": {"apply": "restart", "owner": "C2", "note": "Hard per-file ceiling (100 MiB). 413 data.field=size."}},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "default": {"max_bytes": 5242880, "max_edge": 2048, "max_pixels": 4194304},
          "properties": {
            "max_bytes": {"type": "integer", "minimum": 1024, "default": 5242880, "x-vade": {"apply": "restart", "owner": "C2", "note": "D96: 5 MiB after client compression, not the original pick."}},
            "max_edge": {"type": "integer", "minimum": 16, "maximum": 8192, "default": 2048, "x-vade": {"apply": "restart", "owner": "C2"}},
            "max_pixels": {"type": "integer", "minimum": 1024, "default": 4194304, "x-vade": {"apply": "restart", "owner": "C2", "note": "Decode-bomb ceiling: width*height from the header, checked before any decode."}}
          }
        },
        "part_size": {"type": "integer", "minimum": 65536, "default": 10485760, "x-vade": {"apply": "restart", "owner": "C2", "note": "Part ceiling; the client may propose less, the server clamps to [5 MiB, this]. Body max is part_size + 1 KiB."}},
        "part_max_concurrent": {"type": "integer", "minimum": 1, "maximum": 16, "default": 3, "x-vade": {"apply": "hot", "owner": "C2", "note": "FR-8.39: three parallel parts. Over the limit is 429 OVERLOADED, not a conflict."}},
        "max_per_turn": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10, "x-vade": {"apply": "hot", "owner": "C3", "note": "ui/submit part count (FR-8.41); 20 is the schema hard cap."}},
        "text_max_chars": {"type": "integer", "minimum": 1, "default": 32000, "x-vade": {"apply": "hot", "owner": "C3", "note": "FR-8.45 per-turn text ceiling."}},
        "ttl_hours": {"type": "number", "minimum": 0, "default": 1, "x-vade": {"apply": "restart", "owner": "C2", "note": "Unpinned blob TTL. Pinned blobs never expire (§4.7)."}},
        "upload_idle_ttl_min": {"type": "number", "minimum": 1, "default": 15, "x-vade": {"apply": "hot", "owner": "C2", "note": "An open upload with no new part for this long is 404 and its temp file is collected."}},
        "quota_bytes": {"type": "integer", "minimum": 1048576, "default": 2147483648, "x-vade": {"apply": "hot", "owner": "C2", "note": "Per device, committed + open uploads. The temp area is a quarter of it. 413 data.reason=quota|tmp_quota."}},
        "gc_interval_s": {"type": "number", "minimum": 10, "default": 60, "x-vade": {"apply": "hot", "owner": "C2", "note": "Sweeper period; the GC lease is twice this."}},
        "thumb_px": {"type": "integer", "minimum": 64, "maximum": 1024, "default": 320, "x-vade": {"apply": "hot", "owner": "C2", "note": "`?v=thumb` long edge; derived lazily and never part of dedupe."}},
        "read_scope": {"type": "string", "enum": ["core", "device"], "default": "core", "x-vade": {"apply": "hot", "owner": "C2", "note": "core = any authenticated principal may read (multi-device history); device = uploader only, cross-device is 403 PERMISSION_DENIED."}},
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "default": {"enabled": false, "command": ""},
          "properties": {
            "enabled": {"type": "boolean", "default": false, "x-vade": {"apply": "restart", "owner": "C2", "note": "complete returns status=scanning; HEAD carries scan=pending|clean|infected. Off by default: single-user self-hosting."}},
            "command": {"type": "string", "default": "", "x-vade": {"apply": "restart", "owner": "C2", "note": "Executable plus args; the blob path is appended. Exit 0 = clean, 1 = infected (file removed)."}}
          }
        }
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_all": {"type": "boolean", "default": false, "x-vade": {"apply": "restart", "owner": "C2", "note": "Allows the AllowAll policy (skips approvals). Production must refuse to start without policy/audit components regardless of this flag."}},
        "allow_missing_components": {"type": "boolean", "default": false, "x-vade": {"apply": "restart", "owner": "C2", "note": "Inverse of strict component discovery: false => missing session/policy/audit aborts startup (fail-closed)."}}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global_capacity": {"type": "integer", "minimum": 1, "default": 5000, "x-vade": {"apply": "restart", "owner": "M4a"}},
        "session_capacity": {"type": "integer", "minimum": 1, "default": 200, "x-vade": {"apply": "hot", "owner": "M4a"}},
        "session_inject_char_limit": {"type": "integer", "minimum": 0, "default": 4200, "x-vade": {"apply": "hot", "owner": "M4a", "note": "Injection-side budget."}},
        "recall_k_max": {"type": "integer", "minimum": 1, "default": 20, "x-vade": {"apply": "hot", "owner": "M4a"}},
        "recall_token_limit": {"type": "integer", "minimum": 64, "default": 800, "x-vade": {"apply": "hot", "owner": "M4a"}},
        "ttl_days": {"type": "integer", "minimum": 0, "default": 7, "x-vade": {"apply": "restart", "owner": "M4a"}},
        "embedding_model": {"type": "string", "default": "", "x-vade": {"apply": "restart", "owner": "M4a"}},
        "embedding_dim": {"type": "integer", "minimum": 1, "default": 1536, "x-vade": {"apply": "restart", "owner": "M4a", "note": "Mismatch with the stored index aborts startup."}}
      }
    },
    "evolve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false, "x-vade": {"apply": "hot", "owner": "M4b", "confirm_required": true}},
        "allow_transcript": {"type": "boolean", "default": false, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "allowlist": {"type": "array", "items": {"type": "string"}, "default": [], "x-vade": {"apply": "restart", "owner": "M4b", "note": "module_id + public key fingerprint. `role=evolve` is only honoured for entries here."}},
        "nudge_interval": {"type": "integer", "minimum": 1, "default": 10, "x-vade": {"apply": "hot", "owner": "M4b", "confirm_required": true}},
        "flush_min_turns": {"type": "integer", "minimum": 1, "default": 6, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "session_char_limit": {"type": "integer", "minimum": 0, "default": 4200, "x-vade": {"apply": "hot", "owner": "M4b", "note": "Write-side budget; exceeding it yields MEMORY_FULL."}},
        "summary_token_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.05, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "lesson_confidence_floor": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "failure_learning": {"type": "boolean", "default": true, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "daily_token_budget": {"type": "integer", "minimum": 0, "default": 200000, "x-vade": {"apply": "hot", "owner": "M4b", "confirm_required": true, "note": "0 = unlimited (not recommended)."}},
        "daily_budget_skills": {"type": "integer", "minimum": 0, "default": 5, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "session_budget_skills": {"type": "integer", "minimum": 0, "default": 1, "x-vade": {"apply": "hot", "owner": "M4b"}},
        "redact": {"type": "array", "items": {"type": "string"}, "default": ["tool_args", "file_content"], "x-vade": {"apply": "restart", "owner": "M4b", "note": "Changing this changes the event shape."}},
        "model": {"type": "string", "default": "cheap", "x-vade": {"apply": "hot", "owner": "M4b"}}
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true, "x-vade": {"apply": "hot", "owner": "C3"}},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "x-vade": {"apply": "hot", "owner": "C3"}},
        "target_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2, "x-vade": {"apply": "hot", "owner": "C3"}},
        "protect_last_n": {"type": "integer", "minimum": 0, "default": 20, "x-vade": {"apply": "hot", "owner": "C3"}},
        "protect_first_n": {"type": "integer", "minimum": 0, "default": 3, "x-vade": {"apply": "restart", "owner": "C3"}},
        "tail_mode": {"type": "string", "enum": ["lean", "full"], "default": "lean", "x-vade": {"apply": "restart", "owner": "C3"}},
        "proactive_prune_tokens": {"type": "integer", "minimum": 0, "default": 0, "x-vade": {"apply": "hot", "owner": "C3", "note": "0 = off."}},
        "model": {"type": "string", "default": "cheap", "x-vade": {"apply": "hot", "owner": "C3"}}
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_limit": {"type": "integer", "minimum": 1, "default": 64, "x-vade": {"apply": "restart", "owner": "C3b"}},
        "body_max_chars": {"type": "integer", "minimum": 256, "default": 8192, "x-vade": {"apply": "restart", "owner": "C3b"}},
        "l0_token_budget": {"type": "integer", "minimum": 128, "default": 3000, "x-vade": {"apply": "hot", "owner": "C3b"}},
        "pending_ttl_days": {"type": "integer", "minimum": 1, "default": 7, "x-vade": {"apply": "restart", "owner": "C3b"}},
        "auto_approve": {"type": "boolean", "default": false, "x-vade": {"apply": "hot", "owner": "C3b", "note": "core-only setting; modules must not be able to set it."}}
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "description": "Core-side LLM routing only ([fs]/[bridge] stay in module configs). Secrets are env var NAMES.",
      "properties": {
        "provider": {"type": "string", "default": "openai_compatible", "x-vade": {"apply": "restart", "owner": "C3"}},
        "base_url": {"type": "string", "default": "", "x-vade": {"apply": "restart", "owner": "C3"}},
        "model": {"type": "string", "default": "", "x-vade": {"apply": "hot", "owner": "C3"}},
        "api_key_env": {"type": "string", "default": "", "x-vade": {"apply": "restart", "owner": "C3", "secret": "env-name-only"}},
        "model_module": {"type": "string", "default": "", "x-vade": {"apply": "restart", "owner": "C3", "note": "RFC-0005 §7.5. Empty = any `chat` module may serve; non-empty = only that module_id (closes the PROGRESS technical debt where C3 read the key but C-18 rejected it)."}},
        "fallback_to_builtin": {"type": "boolean", "default": true, "x-vade": {"apply": "restart", "owner": "C3", "note": "RFC-0005 §7.5. Module target offline -> fall back to the builtin provider. An explicit session choice ignores it: the user asked for B, never silently answer with A."}},
        "default_model": {"type": "string", "default": "", "x-vade": {"apply": "hot", "owner": "C3", "note": "RFC-0005 §7.5. Global default as a full `<provider>/<model>` id; empty = manifest priority decides. Resolved per turn, so pointing at a not-yet-registered module is not a startup error."}},
        "capabilities": {"type": "object", "default": {}, "additionalProperties": true, "x-vade": {"apply": "restart", "owner": "C3", "note": "RFC-0005 §4.3: builtin model capabilities. Accepted keys: display_name, input_modalities[text|image|audio|file], max_image_bytes, max_image_px (long edge), max_images_per_turn, context_window, supports_tools. Every key is optional; an omitted key is UNKNOWN (null), never false. Validated field-by-field at read time by `vade.llm.capabilities` (bad value -> null, not a startup failure)."}}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "description": "RFC-0005 §6.4 usage budgets. Deliberately separate from [evolve].daily_token_budget: that one only gates the self-evolution trigger and reads purpose=\"evolve\" rows; these gate chat turns and read purpose=\"chat\" (+ aux when include_aux). Both share the audit trail but never each other's filter.",
      "properties": {
        "enabled": {"type": "boolean", "default": true, "x-vade": {"apply": "hot", "owner": "C3", "note": "false = keep accounting, stop emitting usage.budget and stop refusing turns."}},
        "session_tokens": {"type": "integer", "minimum": 0, "default": 0, "x-vade": {"apply": "hot", "owner": "C3", "note": "Per-session total token budget; 0 = off."}},
        "daily_tokens": {"type": "integer", "minimum": 0, "default": 0, "x-vade": {"apply": "hot", "owner": "C3", "note": "Core-wide tokens per UTC day; 0 = off."}},
        "warn_ratio": {"type": "number", "minimum": 0.1, "maximum": 1, "default": 0.8, "x-vade": {"apply": "hot", "owner": "C3", "note": "used >= limit * warn_ratio enters `warn`; used >= limit is `exceeded`."}},
        "include_aux": {"type": "boolean", "default": true, "x-vade": {"apply": "hot", "owner": "C3", "note": "Count non-chat calls (compaction/memory/evolve) against the budget; false = chat only."}},
        "enforce": {"type": "string", "enum": ["block", "warn"], "default": "block", "x-vade": {"apply": "hot", "owner": "C3", "note": "block = FR-8.49: an exceeded budget refuses `ui/submit` with BUDGET_EXCEEDED. It degrades to a warning (usage.budget.degraded=true) when the ledger is untrustworthy (source=none), so an unreliable number cannot swallow a message."}}
      }
    }
  }
}
