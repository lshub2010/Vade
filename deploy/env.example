# Vade core environment file — sample, no real credentials.
#
# Host install:  copy to /etc/vade/vade.env, chmod 0640, chown root:vade
#                (systemd unit reads it via EnvironmentFile=-/etc/vade/vade.env)
# Compose:       copy to deploy/vade.env, chmod 0600
#                (docker-compose.yml reads it via env_file:)
#
# The core reads secrets ONLY from the environment. `api_key_env` in core.toml
# names the variable; a literal key in core.toml is refused at startup.

# --- LLM credential (required only when [llm].provider = openai_compatible) --
VADE_LLM_API_KEY=[REDACTED]

# --- Optional ---------------------------------------------------------------
# Pin the first-run setup token. Without this, a new token is generated on
# every start until setup completes. Note that an environment variable is
# visible in /proc/<pid>/environ and `docker inspect`; the file
# <data_dir>/setup.token (0600) is the better channel.
# VADE_SETUP_TOKEN=[REDACTED]

# Any config key can be overridden here; `__` separates nesting.
# VADE_CORE__LOG_LEVEL=info
# VADE_CORE__LISTEN=127.0.0.1:8443
# VADE_LLM__MODEL=deepseek-chat

# TLS, only when the core itself terminates TLS (both required together):
# VADE_TLS__CERT=/etc/vade/tls/server.crt
# VADE_TLS__KEY=/etc/vade/tls/server.key

# CORS allowlist, only when the browser UI is served from another origin.
# Arrays are JSON; each origin's host must also appear in [server].listen_hosts.
# VADE_SERVER__UI_ORIGINS=["https://vade.example.com"]
